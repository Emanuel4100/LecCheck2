<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup to the user's Google Drive and phone-to-phone transfer.
     Everything the app stores is included (the database, the automatic backups
     in files/snapshots, preferences) except SharedPreferences: the sign-in
     token is kept there, encrypted with a key that never leaves the phone, so
     a restored copy couldn't be read. After a restore, the user signs in again
     and the restored data syncs as usual. The developer log (dev_log.txt)
     belongs to this phone and isn't copied. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="dev_log.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="dev_log.txt" />
    </device-transfer>
</data-extraction-rules>
